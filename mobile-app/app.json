{
  "expo": {
    "name": "Jeroen & Paws",
    "slug": "jeroen-and-paws-client",
    "scheme": "jeroenandpaws",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jeroenandpaws.clientapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.jeroenandpaws.clientapp"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      },
      "supabaseUrl": "${EXPO_PUBLIC_SUPABASE_URL}",
      "supabaseAnonKey": "${EXPO_PUBLIC_SUPABASE_ANON_KEY}",
      "vercelBackendUrl": "${EXPO_PUBLIC_VERCEL_BACKEND_URL}",
      "apiDryRunExternal": "${EXPO_PUBLIC_API_DRY_RUN_EXTERNAL}",
      "apiDryRunEmailTo": "${EXPO_PUBLIC_API_DRY_RUN_EMAIL_TO}"
    },
    "owner": "REPLACE_WITH_EXPO_OWNER"
  }
}