{
  "expo": {
    "name": "Jeroen & Paws",
    "slug": "jeroen-and-paws",
    "scheme": "jeroenandpaws",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jeroenandpaws.clientapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.jeroenandpaws.clientapp"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "ae5df83e-c9ca-4bef-bfb3-75b3f5008cd7"
      }
    },
    "owner": "jeroen-and-paws"
  }
}
